# OpenClawEco Environment Variables
# 请在申请到密钥后填入实际值

# ─────────────────────────────────────────────
# PostgreSQL (本地)
# ─────────────────────────────────────────────
DATABASE_URL="your_value_here"
DATABASE_URL_TEST="your_value_here"

# ─────────────────────────────────────────────
# Google AI (Gemini Flash + Imagen)
# ─────────────────────────────────────────────
GEMINI_API_KEY="your_value_here"

# ─────────────────────────────────────────────
# Cloudflare R2 (图片存储)
# ─────────────────────────────────────────────
R2_ACCESS_KEY_ID="your_value_here"
R2_SECRET_ACCESS_KEY="your_value_here"
R2_BUCKET_NAME="your_value_here"
R2_ENDPOINT="your_value_here"
R2_PUBLIC_URL="your_value_here"

# ─────────────────────────────────────────────
# Cloudflare Pages (部署)
# ─────────────────────────────────────────────
CLOUDFLARE_API_TOKEN="your_value_here"
CLOUDFLARE_ACCOUNT_ID="your_value_here"

# ─────────────────────────────────────────────
# Crawler Runtime Configurations
# ─────────────────────────────────────────────
# 爬虫定时器频率，默认每半小时
CRAWLER_CRON_SCHEDULE="your_value_here"

# 爬取时间窗（分钟），只收录多长时间内的新闻，1440=24小时
CRAWL_WINDOW_MINUTES="your_value_here"

# 大模型重写使用的模型
LLM_REWRITER_MODEL="your_value_here"

# 生成配图使用的模型列表 (逗号分隔，按顺序灾备降级)
IMAGE_GENERATOR_MODEL="your_value_here"

# 每次定时器触发时最大抓取处理量 (防止配额耗尽 429，不超过50篇)
MAX_BATCH_ARTICLES="your_value_here"
